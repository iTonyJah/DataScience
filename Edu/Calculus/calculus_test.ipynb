    "data = []\n",
    "with open('Student_Performance.txt', 'r') as file:\n",
    "    lines = file.readlines()\n",
    "    headers = lines[0].strip().split(',')\n",
    "    for line in lines[1:]:\n",
    "        values = line.strip().split(',')\n",
    "        # Пропускаем столбец Extracurricular Activities (индекс 2)\n",
    "        row = [float(values[0]), float(values[1]), float(values[3]), float(values[4]), float(values[5])]\n",
    "        data.append(row)\n",
    "\n",
    "data = np.array(data)\n",
    "\n",
    "# Разделение на признаки и целевую переменную\n",
    "X = data[:, :4]  # Hours Studied, Previous Scores, Sleep Hours, Sample Question Papers Practiced\n",
    "y = data[:, 4]   # Performance Index\n",
    "\n",
    "# Нормализация признаков (Z-score нормализация)\n",
    "def normalize_features(X):\n",
    "    mean = np.mean(X, axis=0)\n",
    "    std = np.std(X, axis=0)\n",
    "    X_normalized = (X - mean) / std\n",
    "    return X_normalized, mean, std\n",
    "\n",
    "X_normalized, X_mean, X_std = normalize_features(X)\n",
    "\n",
    "# Добавление столбца единиц для intercept term\n",
    "X_with_intercept = np.column_stack([np.ones(X_normalized.shape[0]), X_normalized])\n",
    "\n",
    "# Параметры градиентного спуска\n",
    "learning_rate = 0.01\n",
    "num_iterations = 10000\n",
    "m = len(y)  # количество примеров\n",
    "\n",
    "# Инициализация весов\n",
    "theta = np.zeros(X_with_intercept.shape[1])\n",
    "\n",
    "# Функция стоимости (MSE)\n",
    "def compute_cost(X, y, theta):\n",
    "    predictions = X.dot(theta)\n",
    "    errors = predictions - y\n",
    "    cost = (1/(2*m)) * np.sum(errors**2)\n",
    "    return cost\n",
    "\n",
    "# Градиентный спуск\n",
    "def gradient_descent(X, y, theta, learning_rate, num_iterations):\n",
    "    cost_history = []\n",
    "    \n",
    "    for i in range(num_iterations):\n",
    "        # Вычисление предсказаний\n",
    "        predictions = X.dot(theta)\n",
    "        \n",
    "        # Вычисление ошибок\n",
    "        errors = predictions - y\n",
    "        \n",
    "        # Вычисление градиента\n",
    "        gradient = (1/m) * X.T.dot(errors)\n",
    "        \n",
    "        # Обновление весов\n",
    "        theta = theta - learning_rate * gradient\n",
    "        \n",
    "        # Сохранение стоимости для визуализации\n",
    "        cost = compute_cost(X, y, theta)\n",
    "        cost_history.append(cost)\n",
    "        \n",
    "        # Вывод прогресса каждые 100 итераций\n",
    "        if i % 1000 == 0:\n",
    "            print(f\"Iteration {i}: Cost = {cost:.4f}\", theta[0])\n",
    "    \n",
    "    return theta, cost_history\n",
    "\n",
    "# Обучение модели\n",
    "print(\"Начало обучения...\")\n",
    "theta, cost_history = gradient_descent(X_with_intercept, y, theta, learning_rate, num_iterations)\n",
    "\n",
    "print(\"\\nОбучение завершено!\")\n",
    "print(f\"Финальная стоимость: {cost_history[-1]:.4f}\")\n",
    "\n",
    "# Вывод найденных весов\n",
    "feature_names = ['Intercept', 'Hours Studied', 'Previous Scores', 'Sleep Hours', 'Sample Question Papers Practiced']\n",
    "print(\"\\nНайденные веса:\")\n",
    "for i, (name, weight) in enumerate(zip(feature_names, theta)):\n",
    "    print(f\"{name}: {weight:.4f}\")\n",
    "\n",
    "# Денормализация весов для интерпретации в исходном масштабе\n",
    "theta_denormalized = theta.copy()\n",
    "# Для intercept\n",
    "theta_denormalized[0] = theta[0] - np.sum(theta[1:] * X_mean / X_std)\n",
    "# Для остальных весов\n",
    "theta_denormalized[1:] = theta[1:] / X_std\n",
    "\n",
    "print(\"\\nВеса в исходном масштабе:\")\n",
    "for i, (name, weight) in enumerate(zip(feature_names, theta_denormalized)):\n",
    "    print(f\"{name}: {weight:.4f}\")\n",
    "\n",
    "# Визуализация сходимости\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(range(num_iterations), cost_history)\n",
    "plt.title('Сходимость градиентного спуска')\n",
    "plt.xlabel('Итерации')\n",
    "plt.ylabel('Стоимость (MSE)')\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# Предсказания и оценка модели\n",
    "predictions = X_with_intercept.dot(theta)\n",
    "\n",
    "# Вычисление R² score\n",
    "ss_total = np.sum((y - np.mean(y))**2)\n",
    "ss_residual = np.sum((y - predictions)**2)\n",
    "r_squared = 1 - (ss_residual / ss_total)\n",
    "\n",
    "print(f\"\\nR² score: {r_squared:.4f}\")\n",
    "\n",
    "# Вывод нескольких примеров предсказаний\n",
    "print(\"\\nПримеры предсказаний:\")\n",
    "print(\"Фактическое | Предсказанное\")\n",
    "for i in range(10):\n",
    "    print(f\"{y[i]:11.1f} | {predictions[i]:12.1f}\")\n",
    "\n",
    "# Функция для предсказания на новых данных\n",
    "def predict_performance(hours_studied, previous_scores, sleep_hours, papers_practiced, theta, X_mean, X_std):\n",
    "    # Нормализация входных данных\n",
    "    features = np.array([hours_studied, previous_scores, sleep_hours, papers_practiced])\n",
    "    features_normalized = (features - X_mean) / X_std\n",
    "    \n",
    "    # Добавление intercept\n",
    "    features_with_intercept = np.concatenate([[1], features_normalized])\n",
    "    \n",
    "    # Предсказание\n",
    "    prediction = features_with_intercept.dot(theta)\n",
    "    return prediction\n",
    "\n",
    "# Пример использования\n",
    "print(\"\\nПример предсказания для нового студента:\")\n",
    "new_prediction = predict_performance(8, 85, 7, 4, theta, X_mean, X_std)\n",
    "print(f\"Hours Studied: 8, Previous Scores: 85, Sleep Hours: 7, Papers Practiced: 4\")\n",
    "print(f\"Предсказанный Performance Index: {new_prediction:.1f}\")"
   ]
