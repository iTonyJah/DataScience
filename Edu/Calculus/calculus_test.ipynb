    "# Определим функцию, которая вычислит градиент:\n",
    "def grad(x, y, z):\n",
    "    return np.array([4*x - 4*z + 4, 8*y - 8*z + 8, -4*x - 8*y + 18*z - 20])\n",
    "\n",
    "# Также запрограммируем простейший вариант для градиентного спуска:\n",
    "def grad_descend(grad, step_size=0.25, num_steps=1):\n",
    "    lst = []\n",
    "    x = [0,0,0]\n",
