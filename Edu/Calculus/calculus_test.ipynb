    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Загрузка данных из файла\n",
    "data = []\n",
    "with open('Student_Performance.txt', 'r') as file:\n",
    "    lines = file.readlines()\n",
    "    headers = lines[0].strip().split(',')\n",
    "    for line in lines[1:]:\n",
    "        values = line.strip().split(',')\n",
    "        # Пропускаем столбец Extracurricular Activities (индекс 2)\n",
    "        row = [float(values[0]), float(values[1]), float(values[3]), float(values[4]), float(values[5])]\n",
    "        data.append(row)\n",
    "\n",
    "data = np.array(data)\n",
    "\n",
    "# Разделение на признаки и целевую переменную\n",
    "X = data[:, :4]  # Hours Studied, Previous Scores, Sleep Hours, Sample Question Papers Practiced\n",
    "y = data[:, 4]   # Performance Index\n",
    "\n",
    "# Добавление столбца единиц для intercept term\n",
    "X_with_intercept = np.column_stack([np.ones(X.shape[0]), X])\n",
    "\n",
    "# Параметры градиентного спуска\n",
    "learning_rate = 0.000384  # Уменьшен learning rate из-за отсутствия нормализации\n",
    "num_iterations = 700_000\n",
    "m = len(y)  # количество примеров\n",
    "\n",
    "# Инициализация весов\n",
    "theta = np.zeros(X_with_intercept.shape[1]) + 5\n",
    "print(theta)\n",
    "\n",
    "# Функция стоимости (MSE)\n",
    "def compute_cost(X, y, theta):\n",
    "    predictions = X.dot(theta)\n",
    "    errors = predictions - y\n",
    "    cost = (1/(2*m)) * np.sum(errors**2)\n",
    "    return cost\n",
    "\n",
    "# Градиентный спуск\n",
    "def gradient_descent(X, y, theta, learning_rate, num_iterations):\n",
    "    cost_history = []\n",
    "    \n",
    "    for i in range(num_iterations):\n",
    "        # Вычисление предсказаний\n",
    "        predictions = X.dot(theta)\n",
    "        \n",
    "        # Вычисление ошибок\n",
    "        errors = predictions - y\n",
    "        \n",
    "        # Вычисление градиента\n",
    "        gradient = (1/m) * X.T.dot(errors)\n",
    "        \n",
    "        # Обновление весов\n",
    "        theta = theta - learning_rate * gradient\n",
    "        \n",
    "        # Сохранение стоимости для визуализации\n",
    "        cost = compute_cost(X, y, theta)\n",
    "        cost_history.append(cost)\n",
    "        \n",
    "        # Вывод прогресса каждые 500 итераций\n",
    "        if i % 25_000 == 0:\n",
    "            print(f\"Iteration {i}: Cost = {cost:.4f}\", theta[0], theta[1], theta[2], theta[3], theta[4])\n",
    "    \n",
    "    return theta, cost_history\n",
    "\n",
    "# Обучение модели\n",
    "print(\"Начало обучения...\")\n",
    "theta, cost_history = gradient_descent(X_with_intercept, y, theta, learning_rate, num_iterations)\n",
    "\n",
    "print(\"\\nОбучение завершено!\")\n",
    "print(f\"Финальная стоимость: {cost_history[-1]:.4f}\")\n",
    "\n",
    "# Вывод найденных весов\n",
    "feature_names = ['Intercept', 'Hours Studied', 'Previous Scores', 'Sleep Hours', 'Sample Question Papers Practiced']\n",
    "print(\"\\nНайденные веса:\")\n",
    "for i, (name, weight) in enumerate(zip(feature_names, theta)):\n",
    "    print(f\"{name}: {weight:.6f}\")\n",
    "\n",
    "# Визуализация сходимости\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(range(num_iterations), cost_history)\n",
    "plt.title('Сходимость градиентного спуска (без нормализации)')\n",
    "plt.xlabel('Итерации')\n",
    "plt.ylabel('Стоимость (MSE)')\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# Предсказания и оценка модели\n",
    "predictions = X_with_intercept.dot(theta)\n",
    "\n",
    "# Вычисление R² score\n",
    "ss_total = np.sum((y - np.mean(y))**2)\n",
    "ss_residual = np.sum((y - predictions)**2)\n",
    "r_squared = 1 - (ss_residual / ss_total)\n",
    "\n",
    "print(f\"\\nR² score: {r_squared:.4f}\")\n",
    "\n",
    "# Вывод нескольких примеров предсказаний\n",
    "print(\"\\nПримеры предсказаний:\")\n",
    "print(\"Фактическое | Предсказанное | Ошибка\")\n",
    "for i in range(10):\n",
    "    error = abs(y[i] - predictions[i])\n",
    "    print(f\"{y[i]:11.1f} | {predictions[i]:12.1f} | {error:6.1f}\")\n",
    "\n",
    "# Статистика ошибок\n",
    "errors = abs(y - predictions)\n",
    "print(f\"\\nСтатистика ошибок:\")\n",
    "print(f\"Средняя абсолютная ошибка: {np.mean(errors):.2f}\")\n",
    "print(f\"Максимальная ошибка: {np.max(errors):.2f}\")\n",
    "print(f\"Минимальная ошибка: {np.min(errors):.2f}\")\n",
    "\n",
    "# Функция для предсказания на новых данных\n",
    "def predict_performance(hours_studied, previous_scores, sleep_hours, papers_practiced, theta):\n",
    "    # Создание вектора признаков с intercept\n",
    "    features = np.array([1, hours_studied, previous_scores, sleep_hours, papers_practiced])\n",
    "    \n",
    "    # Предсказание\n",
    "    prediction = features.dot(theta)\n",
    "    return prediction\n",
    "\n",
    "# Примеры использования\n",
    "print(\"\\nПримеры предсказаний для новых студентов:\")\n",
    "test_cases = [\n",
    "    (6, 75, 7, 3),   # средний студент\n",
    "    (9, 90, 8, 6),   # успешный студент\n",
    "    (3, 60, 5, 1)    # слабый студент\n",
    "]\n",
    "\n",
    "for case in test_cases:\n",
    "    hours, prev_score, sleep, papers = case\n",
    "    prediction = predict_performance(hours, prev_score, sleep, papers, theta)\n",
    "    print(f\"Часы: {hours}, Пред.оценка: {prev_score}, Сон: {sleep}, Тесты: {papers} -> Прогноз: {prediction:.1f}\")\n",
    "\n",
    "# Анализ важности признаков\n",
    "print(\"\\nАнализ важности признаков (по абсолютным значениям весов):\")\n",
    "feature_importance = list(zip(feature_names[1:], abs(theta[1:])))\n",
    "feature_importance.sort(key=lambda x: x[1], reverse=True)\n",
    "\n",
    "for feature, importance in feature_importance:\n",
    "    print(f\"{feature}: {importance:.6f}\")"
